---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { slugToHref } from "../utils/nav";

export async function getStaticPaths() {
  const all = await getCollection("notes");
  return all
    .filter((entry) => entry.id !== "index")
    .map((entry) => {
      const cleaned = entry.id.replace(/(^|\/)index$/, "");
      return { params: { slug: cleaned }, props: { entry } };
    });
}

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);

const parts = entry.id.split("/");
const isSubjectIndex = parts.length === 2 && parts[1] === "index";
const subjectSlug = parts[0];

let subjectTitle: string | null = null;
if (!isSubjectIndex) {
  const all = await getCollection("notes");
  const subjectIndex = all.find((e) => e.id === `${subjectSlug}/index`);
  subjectTitle = subjectIndex?.data.title ?? null;
}
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  {subjectTitle && (
    <div style="font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); margin-bottom:6px;">
      <a href={slugToHref(`${subjectSlug}/index`)} style="color:var(--text-muted);">{subjectTitle}</a>
    </div>
  )}

  <h1>{entry.data.title}</h1>

  {entry.data.tags.length > 0 && (
    <div style="display:flex; gap:6px; flex-wrap:wrap; margin:-8px 0 20px;">
      {entry.data.tags.map((tag) => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>
  )}

  <Content />
</BaseLayout>
