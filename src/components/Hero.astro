---
// Hero de la portada, portado del mockup v2. Campo de luciérnagas
// generado por script, h1 en Cinzel Decorative con resplandor, tagline,
// teaser de El Herbario y la enredadera SVG con cuatro gemas que laten.
// Se usa solo en la portada.
import { SITE_NAME, SITE_TAGLINE } from "../site.config.mjs";

const herbarioHref = `${import.meta.env.BASE_URL}herbario/`;
---

<div class="hero">
  <div id="fireflies" aria-hidden="true"></div>

  <h1>{SITE_NAME}</h1>
  <p class="tagline">{SITE_TAGLINE.replace(/\.$/, "")}</p>

  <a class="herbario-teaser" href={herbarioHref}>
    <span class="herbario-teaser-dot"></span>
    El Herbario
  </a>

  <svg class="vine" viewBox="0 0 420 40" fill="none" aria-hidden="true">
    <path
      d="M10 20 Q 60 5, 100 20 T 190 20 Q 230 35, 270 20 T 360 20 Q 390 10, 410 20"
      stroke="url(#vgrad)"
      stroke-width="2"
      stroke-linecap="round"
    />
    <circle class="vine-gem gem-green" cx="100" cy="20" r="3.5" fill="#4f7a3f" style="animation-delay:0s" />
    <circle class="vine-gem gem-violet" cx="190" cy="20" r="3" fill="#8452b8" style="animation-delay:0.9s" />
    <circle class="vine-gem gem-green" cx="270" cy="20" r="3.5" fill="#4f7a3f" style="animation-delay:1.8s" />
    <circle class="vine-gem gem-violet" cx="360" cy="20" r="3" fill="#8452b8" style="animation-delay:2.7s" />
    <defs>
      <linearGradient id="vgrad" x1="0" y1="0" x2="420" y2="0">
        <stop offset="0" stop-color="#4f7a3f" stop-opacity="0.18" />
        <stop offset="0.5" stop-color="#8452b8" />
        <stop offset="1" stop-color="#4f7a3f" stop-opacity="0.18" />
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: 70px 20px 40px;
    overflow: hidden;
  }
  .hero h1 {
    font-family: var(--font-roman);
    font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    margin: 0;
    letter-spacing: 0.02em;
    color: var(--heading);
    text-shadow: 0 0 40px var(--accent-glow);
  }
  .hero .tagline {
    font-style: italic;
    color: var(--text-muted);
    font-size: 1.2rem;
    margin-top: 10px;
  }

  .firefly {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 8px 2px rgba(185, 160, 107, 0.8);
    animation: drift 9s ease-in-out infinite, glow 3s ease-in-out infinite;
    opacity: 0;
  }
  @keyframes drift {
    0% { transform: translate(0, 0); }
    50% { transform: translate(var(--dx, 20px), var(--dy, -30px)); }
    100% { transform: translate(0, 0); }
  }
  @keyframes glow {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
  }

  .herbario-teaser {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--moss);
    text-decoration: none;
    border: 1px solid var(--moss-soft);
    padding: 8px 18px;
    border-radius: 999px;
    transition: border-color 0.2s, background 0.2s;
  }
  .herbario-teaser:hover {
    border-color: var(--moss);
    background: var(--moss-soft);
  }
  .herbario-teaser-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moss);
    box-shadow: 0 0 6px 1px var(--moss-soft);
    flex-shrink: 0;
  }

  .vine {
    display: block;
    margin: 26px auto 0;
    width: min(420px, 80%);
  }
  .vine-gem {
    transform-origin: center;
    transform-box: fill-box;
    animation: gem-pulse 3.6s ease-in-out infinite;
  }
  .vine-gem.gem-green { filter: drop-shadow(0 0 3px rgba(79, 122, 63, 0.9)); }
  .vine-gem.gem-violet { filter: drop-shadow(0 0 3px rgba(132, 82, 184, 0.9)); }
  @keyframes gem-pulse {
    0%, 100% { opacity: 0.5; transform: scale(0.88); }
    50% { opacity: 1; transform: scale(1.18); }
  }

  @media (prefers-reduced-motion: reduce) {
    .firefly, .vine-gem { animation: none; }
    .firefly { opacity: 0.6; }
    .vine-gem { opacity: 0.85; }
  }
</style>

<script>
  const field = document.getElementById("fireflies");
  if (field && !field.childElementCount) {
    for (let i = 0; i < 14; i++) {
      const f = document.createElement("div");
      f.className = "firefly";
      f.style.left = Math.random() * 100 + "%";
      f.style.top = Math.random() * 100 + "%";
      f.style.setProperty("--dx", Math.random() * 60 - 30 + "px");
      f.style.setProperty("--dy", Math.random() * 60 - 30 + "px");
      f.style.animationDelay = Math.random() * 6 + "s, " + Math.random() * 3 + "s";
      field.appendChild(f);
    }
  }
</script>
